# ==============================================================================
# Multi-Stage Hermetic Build: Web Dashboard Static Client
# Base Image: Unprivileged Alpine Nginx (Rootless, Non-Root UID 101)
# ==============================================================================

# Stage 1: Build Frontend Assets
FROM node:22-alpine AS builder

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@10.5.2 --activate

# Copy monorepo configuration files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.json ./
COPY packages/protocol ./packages/protocol
COPY packages/crypto-core ./packages/crypto-core
COPY packages/cli ./packages/cli
COPY apps/web ./apps/web

# Install and build
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @cip/protocol build
RUN pnpm --filter @cip/crypto-core build
RUN pnpm --filter @cip/cli build
RUN pnpm --filter @cip/web build

# Stage 2: Hardened Unprivileged Web Server
FROM nginxinc/nginx-unprivileged:alpine-slim AS runner

# Copy customized hardened nginx config
COPY infra/docker/nginx.conf /etc/nginx/nginx.conf

# Copy compiled static assets from builder
COPY --from=builder --chown=101:101 /app/apps/web/dist /usr/share/nginx/html

USER 101

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://localhost:8080/ || exit 1

CMD ["nginx", "-g", "daemon off;"]

