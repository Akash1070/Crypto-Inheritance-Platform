# ==============================================================================
# Multi-Stage Hermetic Build: Isolated Enclave Release-Signer Microservice
# Base Image: Hardened Node 22 Alpine (Unprivileged User 'node' UID 1000)
# Security Mandate: <1000 LOC, Zero Outbound Network Access, Multi-Clock Verification
# ==============================================================================

FROM node:22-alpine AS builder

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@10.5.2 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.json ./
COPY packages/protocol ./packages/protocol
COPY packages/crypto-core ./packages/crypto-core
COPY apps/release-signer ./apps/release-signer

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @cip/protocol build
RUN pnpm --filter @cip/crypto-core build
RUN pnpm --filter @cip/release-signer build

FROM node:22-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3001

RUN apk add --no-cache dumb-init

USER node

COPY --from=builder --chown=node:node /app/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/package.json ./package.json
COPY --from=builder --chown=node:node /app/packages/protocol/dist ./packages/protocol/dist
COPY --from=builder --chown=node:node /app/packages/protocol/package.json ./packages/protocol/package.json
COPY --from=builder --chown=node:node /app/packages/crypto-core/dist ./packages/crypto-core/dist
COPY --from=builder --chown=node:node /app/packages/crypto-core/package.json ./packages/crypto-core/package.json
COPY --from=builder --chown=node:node /app/apps/release-signer/dist ./apps/release-signer/dist
COPY --from=builder --chown=node:node /app/apps/release-signer/package.json ./apps/release-signer/package.json

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://localhost:3001/health || exit 1

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node", "apps/release-signer/dist/main.js"]

