# ==============================================================================
# Multi-Stage Hermetic Build: Vault Coordination API
# Base Image: Hardened Node 22 Alpine (Unprivileged User 'node' UID 1000)
# ==============================================================================

FROM node:22-alpine AS builder

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@10.5.2 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.json ./
COPY packages/protocol ./packages/protocol
COPY packages/crypto-core ./packages/crypto-core
COPY apps/api ./apps/api

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @cip/protocol build
RUN pnpm --filter @cip/crypto-core build
RUN pnpm --filter @cip/api build

FROM node:22-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000

# Install dumb-init for proper PID 1 signal and zombie process reaping
RUN apk add --no-cache dumb-init

USER node

COPY --from=builder --chown=node:node /app/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/package.json ./package.json
COPY --from=builder --chown=node:node /app/packages/protocol/dist ./packages/protocol/dist
COPY --from=builder --chown=node:node /app/packages/protocol/package.json ./packages/protocol/package.json
COPY --from=builder --chown=node:node /app/packages/crypto-core/dist ./packages/crypto-core/dist
COPY --from=builder --chown=node:node /app/packages/crypto-core/package.json ./packages/crypto-core/package.json
COPY --from=builder --chown=node:node /app/apps/api/dist ./apps/api/dist
COPY --from=builder --chown=node:node /app/apps/api/package.json ./apps/api/package.json

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://localhost:3000/health || exit 1

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node", "apps/api/dist/index.js"]

