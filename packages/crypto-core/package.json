{
  "name": "@cip/crypto-core",
  "version": "0.1.0",
  "private": true,
  "description": "Cryptographic engine for Crypto Inheritance Platform. Zero external network dependencies.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src/ --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist coverage"
  },
  "dependencies": {
    "@noble/hashes": "^1.7.1",
    "libsodium-wrappers-sumo": "^0.7.15"
  },
  "devDependencies": {
    "@types/libsodium-wrappers-sumo": "^0.7.8",
    "@vitest/coverage-v8": "^3.0.7",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}

